# Full public URL, including repository path. The Pages workflow sets this automatically.
NEXT_PUBLIC_SITE_URL=https://amir-amani.github.io/team-portfolio
# Empty for local development or a custom domain; /team-portfolio for a Pages build.
# The Pages workflow obtains the correct prefix from GitHub automatically.
NEXT_PUBLIC_BASE_PATH=
# Placeholder: replace with an email inbox you control.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Optional. Leave empty to hide social links.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
